# Backend
MONGO_URL=
DB_NAME=sistemamaestro
GROK_API_KEY=
GROK_MODEL=grok-4.3
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Client agent modules. Off until a founder turns them on. See backend/.env.example.
AGENT_MODULE_CHAT_ENABLED=false
AGENT_MODULE_VOZ_ENABLED=false
AGENT_MODULE_WHATSAPP_ENABLED=false
AGENT_MODULE_CITAS_ENABLED=false
TWILIO_AUTH_TOKEN=
TELEPHONY_PUBLIC_URL=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
BOOKINGS_REMINDER_SECRET=

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_GOOGLE_CLIENT_ID=

# Landing publication stays off. Do not point DNS or add Railway domains until that is approved.
# PUBLISH_LANDING_ENABLED=false
# CUSTOM_DOMAIN_ENABLED=false
# BUILDER_PUBLISH_ENABLED=false
# PUBLISH_BASE_DOMAIN=
# PUBLISH_CNAME_TARGET=
# PUBLISH_APEX_TARGET=
# PUBLISH_APP_HOSTS=
# PUBLISH_RESOLVE_CUSTOM_HOSTS=false

# Builder executor loop. Defaults are safe if these are unset.
# Haiku 5.5 and Sonnet 5.5 reject extended-thinking budget_tokens (HTTP 400).
# The loop uses adaptive thinking, bounded by max tokens and effort high or lower.
# BUILDER_EXECUTOR_MAX_ITERATIONS=3
# BUILDER_EXECUTOR_TIMEOUT_SECONDS=110
# BUILDER_EXECUTOR_MAX_TOKENS=4096
# BUILDER_EXECUTOR_THINKING_EFFORT=high

# Builder advisor flow. Off unless ADVISOR_FLOW_ENABLED=true.
# The booking URL is any https calendar page. Leave it empty until one is chosen.
# ADVISOR_FLOW_ENABLED=false
# ADVISOR_BOOKING_URL=
# ADVISOR_PHOTO_URL=
# Local Vite dev can preview the same switch without the API:
# VITE_ADVISOR_FLOW_ENABLED=false
# VITE_ADVISOR_BOOKING_URL=
# VITE_ADVISOR_PHOTO_URL=

# Nova voice, server only. GROK_API_KEY stays on the server (already set in Railway).
# NOVA_VOICE_PROVIDER=grok
# grok (default when GROK_API_KEY is set), browser or off (disable Grok, browser voice), text (greeting only).
# NOVA_GROK_VOICE=ara

# Embeddable voice agent. Off unless set. Admins can open the install step
# while it is off; public sessions stay closed except for an admin's own key.
# EMBED_AGENT_ENABLED=false
# EMBED_AGENT_DAILY_CAP=20
# EMBED_AGENT_RATE_LIMIT=8
# EMBED_AGENT_RATE_WINDOW=600
# Optional. Snippet host. Defaults to the request origin, then sistemamaestro.com.
# EMBED_PUBLIC_ORIGIN=https://sistemamaestro.com
# Optional HMAC secret for the short-lived frame token. Defaults to JWT_SECRET.
# EMBED_AGENT_TOKEN_SECRET=
