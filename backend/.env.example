MONGO_URL=
DB_NAME=sistemamaestro
GROK_API_KEY=
GROK_MODEL=grok-4.3
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Landing publication stays off. Values below are read by the server; leave them empty until DNS is approved.
# PUBLISH_LANDING_ENABLED=false
# CUSTOM_DOMAIN_ENABLED=false
# BUILDER_PUBLISH_ENABLED=false
# PUBLISH_BASE_DOMAIN=
# PUBLISH_CNAME_TARGET=
# PUBLISH_APEX_TARGET=
# PUBLISH_APP_HOSTS=
# PUBLISH_RESOLVE_CUSTOM_HOSTS=false

# Embeddable voice agent. Default off. See the root .env.example.
# EMBED_AGENT_ENABLED=false
# EMBED_AGENT_DAILY_CAP=20
# EMBED_PUBLIC_ORIGIN=https://sistemamaestro.com

# Client agent modules. All default off. No secrets are committed.
AGENT_MODULE_CHAT_ENABLED=false
AGENT_MODULE_VOZ_ENABLED=false
AGENT_MODULE_WHATSAPP_ENABLED=false
AGENT_MODULE_CITAS_ENABLED=false
AGENT_CHAT_RETENTION_DAYS=30
AGENT_CHAT_RATE_LIMIT=20
AGENT_CHAT_RATE_WINDOW_SECONDS=60
AGENT_CHAT_DAILY_COST_CAP_USD=1
AGENT_CHAT_MAX_OUTPUT_TOKENS=400
# Telephony is a Twilio Programmable Voice proposal. There is no account.
TELEPHONY_PROVIDER=twilio
TWILIO_AUTH_TOKEN=
TELEPHONY_PUBLIC_URL=
TELEPHONY_MOCK_SECRET=
# WhatsApp Cloud API names only. There are no credentials yet.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
BOOKINGS_REMINDER_SECRET=

# Builder advisor flow. Off unless ADVISOR_FLOW_ENABLED=true.
# ADVISOR_BOOKING_URL is an https calendar page. Empty keeps the button disabled.
# ADVISOR_FLOW_ENABLED=false
# ADVISOR_BOOKING_URL=
# ADVISOR_PHOTO_URL=
